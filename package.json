{
  "name": "moleculab",
  "private": true,
  "version": "1.4.2",
  "description": "MOLECULAB | BYTE LAB — plataforma web de exploração molecular e ferramentas químicas",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-rdkit.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rdkit/rdkit": "2026.9.2",
    "3dmol": "3.0.0",
    "katex": "^0.16.47",
    "plotly.js-basic-dist-min": "^3.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
